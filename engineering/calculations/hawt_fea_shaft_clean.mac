! ==============================================================================
! ANSYS MECHANICAL APDL SCRIPT: HAWT 10 kW MAIN ROTOR SHAFT & HUB FEA
! Standards: ASME B106.1M / DIN 743 / ISO 281
! Compatible with both Interactive GUI and Batch Mode (-b)
! ==============================================================================
FINISH
/CLEAR
/FILNAME, hawt_shaft_fea, 1
/TITLE, 10 kW HAWT Main Rotor Shaft & Drivetrain FEA

/PREP7

! --- 1. MATERIAL DEFINITION (42CrMo4+QT Alloy Steel) ---
MP, EX,   1, 210.0E9    ! Young's Modulus: 210 GPa
MP, PRXY, 1, 0.30       ! Poisson's Ratio
MP, DENS, 1, 7850.0     ! Density: 7850 kg/m^3

! --- 2. ELEMENT TYPE & CROSS SECTIONS ---
ET, 1, BEAM188          ! 3D 2-Node Timoshenko Beam Element
KEYOPT, 1, 1, 0
KEYOPT, 1, 3, 3

! Section 1: Dia 75 mm Main Shaft Body
SECTYPE, 1, BEAM, CSOLID
SECDATA, 0.0375, 8, 8

! Section 2: Dia 210 mm Flange
SECTYPE, 2, BEAM, CSOLID
SECDATA, 0.1050, 8, 8

! --- 3. GEOMETRY ALONG Y-AXIS (Length = 900 mm) ---
! Y = +0.390 m: Flange Mating Face
! Y = +0.360 m: Flange Shoulder
! Y = +0.140 m: Front Bearing Centerline (Locating)
! Y = -0.140 m: Rear Bearing Centerline (Floating)
! Y = -0.510 m: Generator PMG Coupling
K, 1, 0.0,  0.390, 0.0  ! Flange Face
K, 2, 0.0,  0.360, 0.0  ! Shoulder
K, 3, 0.0,  0.140, 0.0  ! Front Bearing
K, 4, 0.0, -0.140, 0.0  ! Rear Bearing
K, 5, 0.0, -0.510, 0.0  ! Generator Coupling
K, 99, 1.0, 0.0,   0.0  ! Off-axis orientation keypoint

L, 1, 2                 ! Flange section
L, 2, 3                 ! Overhang section
L, 3, 4                 ! Bearing span section
L, 4, 5                 ! Tail extension

! Mesh Flange with Section 2
LSEL, S, LINE,, 1
LATT, 1,, 1,, 99,, 2
LESIZE, ALL, 0.015
LMESH, ALL

! Mesh Shaft with Section 1
LSEL, S, LINE,, 2, 4
LATT, 1,, 1,, 99,, 1
LESIZE, ALL, 0.020
LMESH, ALL
ALLSEL, ALL

! --- 4. BOUNDARY CONDITIONS (BEARING SUPPORTS) ---
! Front Bearing (Node at K3): Fixed in X, Y, Z (Locating Bearing)
DK, 3, UX, 0.0
DK, 3, UY, 0.0
DK, 3, UZ, 0.0

! Rear Bearing (Node at K4): Fixed in X, Z (Axially Floating)
DK, 4, UX, 0.0
DK, 4, UZ, 0.0

! Generator Coupling (Node at K5): Torsional reaction
DK, 5, ROTY, 0.0

! --- 5. MECHANICAL LOADS ---
! Peak Torsion: T = 1693.5 N*m applied at Flange Face (K1)
FK, 1, MY, 1693.5

! Overhung Rotor Weight + Tilt Bending: FZ = -1520.6 N at K1
FK, 1, FZ, -1520.6

! Gyroscopic Yaw Moment: MX = 1420.6 N*m at K1
FK, 1, MX, 1420.6

! Axial Thrust: FY = -1440.0 N at K1
FK, 1, FY, -1440.0

! --- 6. SOLUTION ---
/SOLU
ANTYPE, STATIC
SOLVE
FINISH

! --- 7. POST-PROCESSING ---
/POST1
SET, LAST
*GET, MAX_FLANGE_DEF, NODE, 1, U, Z
*GET, FRONT_BRG_RADIAL, NODE, 3, RF, FZ
*GET, REAR_BRG_RADIAL, NODE, 4, RF, FZ

/OUTPUT, C:\NaveenCADAgent\ansys_work\shaft_fea_results, txt
*STATUS, MAX_FLANGE_DEF
*STATUS, FRONT_BRG_RADIAL
*STATUS, REAR_BRG_RADIAL
/OUTPUT
FINISH
! ==============================================================================
